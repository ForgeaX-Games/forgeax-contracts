{
  "name": "@forgeax/types",
  "version": "0.1.1",
  "type": "module",
  "description": "Shared zod schemas + TS contracts for forgeax-extension.json, agent/skill/tool/host-sdk. Single source of truth for ExtensionManifest validation across server / interface / cli.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./manifest": "./dist/manifest.js",
    "./page": "./dist/page.js",
    "./agent": "./dist/agent.js",
    "./skill": "./dist/skill.js",
    "./tool": "./dist/tool.js",
    "./host-sdk": "./dist/host-sdk.js",
    "./observability": "./dist/observability.js",
    "./permission-rules": "./dist/permission-rules.js",
    "./shell-split": "./dist/shell-split.js",
    "./visual-generation": "./dist/visual-generation.js",
    "./npc-protocol": "./dist/npc-protocol.js",
    "./npc-tools": "./dist/npc-tools.js",
    "./schemas/npc/*": "./schemas/npc/*",
    "./capability": "./dist/capability.js",
    "./deliver-summary": "./dist/deliver-summary.js",
    "./artifact-summary": "./dist/artifact-summary.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate:npc-schemas": "bun scripts/generate-npc-schemas.ts",
    "check:npc-schema-drift": "bun scripts/check-npc-schema-drift.ts",
    "lint": "bun run check:npc-schema-drift",
    "validate-manifests": "bun test/validate-manifests.ts"
  },
  "dependencies": {
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.6.3"
  }
}
